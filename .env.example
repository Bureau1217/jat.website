# Local dev: points to the local Kirby CMS (jat.cms, `composer start`)
NUXT_API_URL=http://localhost:8000/
# Panel user used by the server for KQL (Basic auth) — never exposed to the browser
NUXT_API_AUTH_EMAIL=
NUXT_API_AUTH_PASSWORD=
# Canonical public origin for canonical URLs, Open Graph and /sitemap.xml
# (empty = the host of the request)
NUXT_PUBLIC_SITE_URL=
# Newsletter sign-up through the Mailchimp API (both empty = the footer form
# posts to the « Adresse du formulaire d'inscription » set in the Panel)
NUXT_MAILCHIMP_API_KEY=
NUXT_MAILCHIMP_LIST_ID=
